    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(item => item.json);\n\n// Exclude any existing summary/total row\nconst expenses = rows.filter(row =>\n  String(row.Purpose || \"\").trim().toLowerCase() !== \"total\"\n);\n\nconst total = expenses.reduce((sum, row) => {\n  return sum + (Number(row.Amount) || 0);\n}, 0);\n\nconst lines = expenses.map((row, index) => {\n  const date = row.Date || \"Date not provided\";\n  const purpose = row.Purpose || \"Unspecified\";\n  const amount = Number(row.Amount) || 0;\n\n  return `${index + 1}. ${date} | ${purpose} | ₹${amount.toLocaleString(\"en-IN\")}`;\n});\n\nconst emailBody = [\n  \"EXPENSE SUMMARY REPORT\",\n  \"\",\n  \"Here is your expense summary:\",\n  \"\",\n  ...lines,\n  \"\",\n  `Total expenses: ₹${total.toLocaleString(\"en-IN\")}`,\n  `Number of records: ${expenses.length}`\n].join(\"\\n\");\n\nreturn [{\n  json: {\n    email_subject: \"Expense Summary Report\",\n    recipient_email: \"padmalojani@gmail.com\",\n    email_body: emailBody,\n    total_amount: total,\n    record_count: expenses.length\n  }\n}];\n"
      },
